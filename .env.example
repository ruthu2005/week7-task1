# Server Port
PORT=5000

# MongoDB Connection URI (automatically falls back to resilient in-memory store if offline)
MONGODB_URI=mongodb://127.0.0.1:27017/jwt_auth_db

# JSON Web Token Secret Key (Must be kept secure and private)
JWT_SECRET=super_secret_jwt_key_replace_in_production_environment_with_strong_entropy

# JWT Expiration Time (e.g., 1h, 15m, 7d)
JWT_EXPIRES_IN=1h

# Node Environment
NODE_ENV=development
